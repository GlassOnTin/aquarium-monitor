[Unit]
Description=Aquarium Data Collector
After=network.target victoria-metrics.service
Wants=victoria-metrics.service

[Service]
Type=simple
User=ian
WorkingDirectory=/home/ian/Code/aquarium-monitor
ExecStartPre=/home/ian/Code/aquarium-monitor/ensure-venv.sh
ExecStart=/home/ian/tuya-env/bin/python /home/ian/Code/aquarium-monitor/collector.py
Restart=always
RestartSec=30
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
