[Unit]
Description=Aquarium Monitor Web Interface
After=network.target victoria-metrics.service

[Service]
Type=simple
User=ian
WorkingDirectory=/home/ian/Code/aquarium-monitor
Environment=FLASK_ENV=production
ExecStartPre=/home/ian/Code/aquarium-monitor/ensure-venv.sh
ExecStart=/home/ian/tuya-env/bin/python /home/ian/Code/aquarium-monitor/app.py
Restart=always
RestartSec=10
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
